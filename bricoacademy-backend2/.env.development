# --- Variables para Docker (MySQL + phpMyAdmin) ---
MYSQL_DATABASE=bricoacademy
MYSQL_USER=root
MYSQL_PASSWORD=test
MYSQL_ROOT_PASSWORD=test

PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=test

EXPRESS_PORT=3000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# --- Variables que usa el backend (config/config.js) ---
# Si ejecutas con docker compose, el host es "db" (nombre del servicio)
DB_HOST=db
DB_USER=root
DB_PASSWORD=test
DB_NAME=bricoacademy
DB_PORT=3306
